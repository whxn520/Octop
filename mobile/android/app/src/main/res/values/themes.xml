<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OctopChat" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_active</item>
        <item name="colorOnPrimary">@color/n1</item>
        <item name="colorSecondary">@color/cta</item>
        <item name="colorOnSecondary">@color/n1</item>
        <item name="colorSurface">@color/n1</item>
        <item name="colorOnSurface">@color/n10</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/n1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.Octop.Button</item>
    </style>

    <style name="Widget.Octop.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand</item>
        <item name="cornerRadius">@dimen/btn_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Octop.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">@color/n10</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.Octop.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/box_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/brand</item>
        <item name="boxBackgroundColor">@color/n1</item>
    </style>
</resources>
